<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: dados do usuário podem ir para backup, a chave da API não. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="nutrivision_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="nutrivision_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
